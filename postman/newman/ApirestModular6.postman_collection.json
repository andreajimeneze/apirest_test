				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('200 OK', () => pm.response.to.have.status(200));\r",
							"pm.test('Producto actualizado', () => {\r",
							"    const res = pm.response.json();\r",
							"    pm.expect(res.nombre).to.eql('Lavadora');\r",
							"});\r",
							"\r",
							"pm.test('Stock actualizado correctamente', () => {\r",
							"    const res = pm.response.json();\r",
							"    pm.expect(res.stock).to.eq(20);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
