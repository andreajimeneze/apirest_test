		{
  "name": "PUT modificar producto",
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Test de status 200",
          "pm.test('200 OK', () => pm.response.to.have.status(200));",

          "// Test de que los campos fueron actualizados correctamente",
          "pm.test('Campos actualizados correctamente', () => {",
          "    const res = pm.response.json();",
          "    const reqBody = JSON.parse(pm.request.body.raw);",

          "    pm.expect(res.nombre).to.eql(reqBody.nombre);",
          "    pm.expect(res.descripcion).to.eql(reqBody.descripcion);",
          "    pm.expect(res.precio).to.eql(reqBody.precio);",
          "    pm.expect(res.stock).to.eql(reqBody.stock);",
          "    pm.expect(res.active).to.eql(reqBody.active);",
          "});"
        ],
        "type": "text/javascript",
        "packages": {}
      }
    }
  ],
  "request": {
    "method": "PUT",
    "header": [
      {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}",
        "type": "text"
      },
      {
        "key": "Content-Type",
        "value": "application/json",
        "type": "text"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n    \"nombre\": \"Computador\",\n    \"descripcion\": \"EPSON\",\n    \"stock\": 25,\n    \"precio\": 500000,\n    \"active\": true\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    },
    "url": {
      "raw": "{{url_base}}{{products_base}}/{{id_product}}",
      "host": [
        "{{url_base}}{{products_base}}"
      ],
      "path": [
        "{{id_product}}"
      ]
    }
  },
  "response": []
}
